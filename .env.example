# Krylo CRM — environment variables template
# Copy to .env and fill in the real values. NEVER commit .env.

# Flask session signing key — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-a-new-one

# Railway PostgreSQL (or leave empty to use SQLite in development)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Anthropic Claude API key — https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Brevo transactional email API key — https://app.brevo.com/settings/keys/api
BREVO_API_KEY=xkeysib-...

# Cron Job Railway — token secreto para /cron/executar-sdr
# Gere com: python -c "import secrets; print(secrets.token_hex(24))"
CRON_TOKEN=change-me-generate-a-new-one
